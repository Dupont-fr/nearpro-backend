MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nearpro
MONGODB_POOL_SIZE=50

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:5173

# Compte administrateur créé par `npm run seed`
ADMIN_EMAIL=admin@nearpro.cm
ADMIN_PASSWORD=AdminNearPro!2026

NODE_ENV=development
PORT=5000

# Montée en charge (voir docs/scale.md)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Cluster multi-cœurs (production uniquement)
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0
CLUSTER_MAX_FAST_EXITS=5